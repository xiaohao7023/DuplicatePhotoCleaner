    "Allow photo access to scan your library and estimate how much space can be cleaned.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Foto-Zugriff, um Ihre Bibliothek zu scannen und abzuschätzen, wie viel Speicherplatz freigemacht werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow photo access to scan your library and estimate how much space can be cleaned."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a tus fotos para escanear tu biblioteca y calcular cuánto espacio se puede liberar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès aux photos pour analyser votre bibliothèque et estimer l'espace pouvant être libéré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso alle foto per analizzare la libreria e stimare quanto spazio liberare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリをスキャンして解放できる容量を見積もるため、写真アクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리를 스캔하고 정리 가능한 용량을 예상하려면 사진 접근을 허용해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso às suas fotos para analisar sua biblioteca e estimar quanto espaço pode ser liberado."
          }
        }
      }
    },
    "Allow photo access to scan your library. You always choose what to remove before anything is deleted.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie den Foto-Zugriff, um Ihre Bibliothek zu scannen. Sie wählen immer selbst, was entfernt wird, bevor etwas gelöscht wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow photo access to scan your library. You always choose what to remove before anything is deleted."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a tus fotos para escanear tu biblioteca. Tú siempre eliges qué eliminar antes de que se borre algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès aux photos pour analyser votre bibliothèque. Vous choisissez toujours quoi supprimer avant toute suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l'accesso alle foto per analizzare la libreria. Scegli sempre tu cosa rimuovere prima di qualsiasi eliminazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリをスキャンするため写真へのアクセスを許可してください。削除前に何を削除するかは常にあなたが選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리를 스캔하려면 사진 접근을 허용해 주세요. 실제 삭제 전 항상 제거할 항목을 직접 선택합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {

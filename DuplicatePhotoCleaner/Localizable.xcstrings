    "Dupes only requests access to analyze and clean the photos you choose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dupes fragt nur Zugriff an, um die von Ihnen gewählten Fotos zu analysieren und zu bereinigen."
          }
        },
        "en": {
          "stringUnit": {

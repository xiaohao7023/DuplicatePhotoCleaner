          "stringUnit": {
            "state": "translated",
            "value": "3 días gratis, luego %@ por año. Se renueva automáticamente a menos que canceles al menos 24 horas antes de la renovación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 jours gratuits, puis %@ par an. Renouvellement automatique sauf annulation 24 heures avant le renouvellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3 giorni gratis, poi %@ all'anno. Rinnovo automatico salvo cancellazione almeno 24 ore prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日間無料、その後は年間%@。更新の24時間前までにキャンセルしない限り自動更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3일 무료, 이후 연 %@. 갱신 24시간 전까지 취소하지 않으면 자동 갱신됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "3 dias grátis, depois %@ por ano. Renova automaticamente, a menos que você cancele pelo menos 24 horas antes."
          }
        }
      }
    },

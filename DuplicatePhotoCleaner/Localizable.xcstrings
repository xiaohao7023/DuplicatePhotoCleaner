    "Every scan runs privately on your iPhone. Nothing is uploaded, shared, or used to train a model.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Scan läuft privat auf Ihrem iPhone. Nichts wird hochgeladen, geteilt oder zum Trainieren eines Modells verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every scan runs privately on your iPhone. Nothing is uploaded, shared, or used to train a model."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada escaneo se ejecuta de forma privada en tu iPhone. Nada se sube, comparte ni se usa para entrenar un modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque analyse s'exécute en privé sur votre iPhone. Rien n'est téléchargé, partagé ou utilisé pour entraîner un modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni analisi viene eseguita privatamente sul tuo iPhone. Nulla viene caricato, condiviso o usato per addestrare un modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのスキャンは iPhone 内でプライベートに実行されます。アップロード・共有・モデル学習には一切使われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 스캔은 iPhone에서 프라이빗하게 실행됩니다. 아무것도 업로드·공유되지 않으며 모델 학습에도 사용되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada análise é executada de forma privada no seu iPhone. Nada é enviado, compartilhado ou usado para treinar um modelo."
          }
        }
      }
    },

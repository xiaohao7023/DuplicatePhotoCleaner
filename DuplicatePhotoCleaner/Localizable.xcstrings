    "All photo analysis happens on your device. Nothing is uploaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesamte Fotoanalyse erfolgt auf Ihrem Gerät. Es wird nichts hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All photo analysis happens on your device. Nothing is uploaded."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo el análisis de fotos ocurre en tu dispositivo. Nada se sube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute l'analyse des photos s'effectue sur votre appareil. Rien n'est téléchargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta l'analisi delle foto avviene sul tuo dispositivo. Nulla viene caricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての写真分析は端末上で行われます。アップロードされるものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사진 분석은 기기에서만 진행됩니다. 어떤 것도 업로드되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a análise de fotos acontece no seu dispositivo. Nada é enviado."
          }
        }
      }
    },
